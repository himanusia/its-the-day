<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/itstheday_widget_background"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Your next mark"
            android:textColor="#EFF5F0"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="D-7"
            android:textColor="#A9F4D0"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="TODAY · 0/10"
            android:textColor="#FFD28A"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
