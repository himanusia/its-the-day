{
  "manifest_version": 3,
  "name": "It's the Day! — hosted companion",
  "version": "1.0.0",
  "description": "A small, installable doorway to the hosted It's the Day! app.",
  "action": {
    "default_title": "Open It's the Day!",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://its-the-day.himanusia.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
